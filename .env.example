# Churchill Brothers FC Goa Platform Environment Variables
# Compliant with Master Specification Part 15 (Demo Mode Architecture)

# Mandatory Demo Mode flag
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Configuration (Optional for local evaluation; fallback local store is enabled out-of-the-box)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (for server migrations / administrative scripts ONLY; never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Club Domain
NEXT_PUBLIC_SITE_URL=https://churchillbrothers.com
